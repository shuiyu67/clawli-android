<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/connect_subtitle"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeLan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/mode_lan" />

            <RadioButton
                android:id="@+id/modeCloud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_cloud" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/lanBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/lanHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_lan_host"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/lanPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_lan_port"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cloudBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/cloudRelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_cloud_relay"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/cloudRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_cloud_room"
                android:inputType="text" />

            <EditText
                android:id="@+id/cloudToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_cloud_token"
                android:inputType="text" />
        </LinearLayout>

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/connect" />
    </LinearLayout>
</ScrollView>
